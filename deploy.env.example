# Copy to deploy.env (gitignored) and fill in the target host. Used by scripts/deploy.sh.
DEPLOY_HOST=server.example
DEPLOY_USER=user
DEPLOY_PATH=/home/user/JunctionPerception
# SSH client that holds the key for the server (for example the Windows OpenSSH client).
DEPLOY_SSH=ssh
# Dataset root on the server (recordings for the twin server).
DEPLOY_DATA_ROOT=/home/user/Dataset
DEPLOY_SERVER_PORT=8080
# Optional: key of the Google Map Tiles API for Google imagery in the map layers.
DEPLOY_GOOGLE_MAPS_API_KEY=
