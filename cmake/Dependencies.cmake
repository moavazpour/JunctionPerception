find_package(Threads REQUIRED)
find_package(OpenCV REQUIRED COMPONENTS core imgproc imgcodecs videoio video features2d calib3d)
find_package(Eigen3 3.3 REQUIRED NO_MODULE)
find_package(yaml-cpp REQUIRED)
find_package(nlohmann_json 3.10 REQUIRED)
find_package(spdlog REQUIRED)

if(JP_WITH_TENSORRT)
  find_package(CUDAToolkit REQUIRED)
  find_path(TENSORRT_INCLUDE_DIR NvInfer.h HINTS /usr/include/x86_64-linux-gnu /usr/include/aarch64-linux-gnu /usr/local/tensorrt/include)
  find_library(TENSORRT_NVINFER nvinfer HINTS /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/local/tensorrt/lib)
  find_library(TENSORRT_ONNXPARSER nvonnxparser HINTS /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/local/tensorrt/lib)
  if(NOT TENSORRT_INCLUDE_DIR OR NOT TENSORRT_NVINFER OR NOT TENSORRT_ONNXPARSER)
    message(FATAL_ERROR "TensorRT not found; configure with -DJP_WITH_TENSORRT=OFF for a CPU-only build")
  endif()
  add_library(jp_tensorrt INTERFACE)
  target_include_directories(jp_tensorrt INTERFACE ${TENSORRT_INCLUDE_DIR})
  target_link_libraries(jp_tensorrt INTERFACE ${TENSORRT_NVINFER} ${TENSORRT_ONNXPARSER} CUDA::cudart)
endif()

if(JP_WITH_MQTT)
  find_library(PAHO_MQTT_C paho-mqtt3as REQUIRED)
  find_path(PAHO_MQTT_C_INCLUDE MQTTAsync.h REQUIRED)
  add_library(jp_paho INTERFACE)
  target_include_directories(jp_paho INTERFACE ${PAHO_MQTT_C_INCLUDE})
  target_link_libraries(jp_paho INTERFACE ${PAHO_MQTT_C})
endif()
