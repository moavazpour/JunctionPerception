# Development and build image: GCC 14, CMake, Ninja, vcpkg, clang tools and Node.js.
FROM node:22.20.0-bookworm-slim AS node

FROM ubuntu:24.04

ARG VCPKG_TAG=2026.10.16
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc-14 g++-14 cmake ninja-build pkg-config \
        git curl ca-certificates zip unzip tar python3 \
        clang-format-18 clang-tidy-18 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN git clone --branch "${VCPKG_TAG}" https://github.com/microsoft/vcpkg.git /opt/vcpkg \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics \
    && chmod -R a+rwX /opt/vcpkg \
    && git config --system --add safe.directory '*'

# Caches live under /cache, which scripts/in_docker.sh mounts from the repository's .cache folder.
ENV CC=gcc-14 \
    CXX=g++-14 \
    VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DEFAULT_BINARY_CACHE=/cache/vcpkg-binary \
    VCPKG_DOWNLOADS=/cache/vcpkg-downloads \
    npm_config_cache=/cache/npm \
    HOME=/tmp
