# Development and build image: GCC 14, CMake, Ninja, vcpkg, clang tools, Node.js, ONNX Runtime and
# the Python packages of the site manager.
# The default build is CPU-only (used by CI). For an NVIDIA GPU host, build on a CUDA + cuDNN base
# with the CUDA build of ONNX Runtime (scripts/setup_server.sh does this when a GPU is present):
#   --build-arg BASE_IMAGE=nvidia/cuda:13.2.1-cudnn-runtime-ubuntu24.04
#   --build-arg ORT_PACKAGE=onnxruntime-linux-x64-gpu_cuda13-1.31.0
ARG BASE_IMAGE=ubuntu:24.04

FROM node:22.20.0-bookworm-slim AS node

FROM ${BASE_IMAGE}

ARG VCPKG_TAG=2026.10.16
ARG ORT_VERSION=1.31.0
ARG ORT_PACKAGE=onnxruntime-linux-x64-1.31.0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc-14 g++-14 cmake ninja-build pkg-config \
        git curl ca-certificates zip unzip tar python3 \
        autoconf automake autoconf-archive libtool nasm \
        clang-format-18 clang-tidy-18 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN git clone --branch "${VCPKG_TAG}" https://github.com/microsoft/vcpkg.git /opt/vcpkg \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics \
    && chmod -R a+rwX /opt/vcpkg \
    && git config --system --add safe.directory '*'

RUN curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/${ORT_PACKAGE}.tgz" \
        | tar -xz -C /opt \
    && mv "/opt/${ORT_PACKAGE}" /opt/onnxruntime

# Site manager (manager/jp_manager.py) and the map tool (tools/prepare_map_data.py).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-aiohttp python3-yaml python3-requests python3-pyproj python3-lxml \
    && rm -rf /var/lib/apt/lists/*

# Caches live under /cache, which scripts/in_docker.sh mounts from the repository's .cache folder.
ENV CC=gcc-14 \
    CXX=g++-14 \
    VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DEFAULT_BINARY_CACHE=/cache/vcpkg-binary \
    VCPKG_DOWNLOADS=/cache/vcpkg-downloads \
    ORT_ROOT=/opt/onnxruntime \
    npm_config_cache=/cache/npm \
    HOME=/tmp
