# Site manager (FastAPI): starts one perception container per site through the Docker socket.
FROM python:3.11.10-slim
RUN pip install --no-cache-dir fastapi==0.115.0 uvicorn==0.30.6 python-multipart==0.0.9 docker==7.1.0 pyyaml==6.0.2
WORKDIR /app
COPY manager/app.py .
EXPOSE 8000
CMD ["python", "app.py"]
